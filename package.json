{
  "name": "deadwire",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "art:build": "python3 scripts/art_factory.py build",
    "art:validate": "python3 scripts/art_factory.py validate",
    "art:doctor": "python3 scripts/art_factory.py doctor",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src tests docs/*.md *.ts *.json *.md index.html .github",
    "format:check": "prettier --check src tests docs/*.md *.ts *.json *.md index.html .github",
    "art:test": "python3 scripts/test_art_factory.py"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/three": "^0.180.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "description": "An open-source extraction-shooter prototype with a reusable Blender game art factory.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ErikBurdett/deadwire.git"
  }
}
